# Voorbeeldconfiguratie — kopieer naar .env en vul in. Nooit .env committen.
APP_ENV=prod
DATABASE_URL=sqlite:////data/huishoud.db

# sub van het Authelia-account dat bij de eerste start beheerder wordt
INITIAL_ADMIN_SUB=
INITIAL_ADMIN_NAME=Beheerder

SESSION_MAX_AGE_DAYS=90

# Publieke URL van de app en de OIDC-client in Authelia
BASE_URL=https://huishoud.example.com
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=huishoud
OIDC_CLIENT_SECRET=

# Nachtelijke back-up (03:15) van de database; standaard naast de database.
BACKUP_DIR=/data/backups
BACKUP_KEEP=14

# Meldingen (Web Push). Maak sleutels met:
#   docker compose run --rm huishoud python -m app.push sleutels
# Zonder deze drie staan meldingen uit. De privésleutel is geheim; als je
# hem vervangt moet iedereen meldingen opnieuw aanzetten.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jij@example.com

# IP van de reverse proxy (nooit *)
FORWARDED_ALLOW_IPS=
